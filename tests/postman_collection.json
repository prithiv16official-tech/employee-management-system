{
  "info": {
    "name": "Employee Management System",
    "description": "API test collection for Employee Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    }
  ],
  "item": [
    {
      "name": "Create Employee",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/employees/",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employee_id\": \"EMP001\",\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"email\": \"john.doe@company.com\",\n  \"phone\": \"9876543210\",\n  \"position\": \"Software Engineer\",\n  \"department\": \"IT\",\n  \"salary\": 50000.00,\n  \"hire_date\": \"2024-01-15\",\n  \"status\": \"active\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', function() { pm.response.to.have.status(201); });",
              "pm.test('Response has employee_id', function() { pm.expect(pm.response.json().employee_id).to.eql('EMP001'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Get All Employees",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/employees/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function() { pm.response.to.have.status(200); });",
              "pm.test('Response is list', function() { pm.expect(pm.response.json()).to.have.property('results'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Single Employee",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/employees/1/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function() { pm.response.to.have.status(200); });",
              "pm.test('Has employee data', function() { pm.expect(pm.response.json()).to.have.property('first_name'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Update Employee",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/employees/1/",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"position\": \"Senior Software Engineer\",\n  \"salary\": 65000.00\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function() { pm.response.to.have.status(200); });",
              "pm.test('Position updated', function() { pm.expect(pm.response.json().position).to.eql('Senior Software Engineer'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete Employee",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/employees/1/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 204', function() { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Search Employees",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/employees/?search=John",
          "host": ["{{base_url}}"],
          "path": ["employees"],
          "query": [{ "key": "search", "value": "John" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function() { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Filter by Department",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/employees/?department=IT",
          "host": ["{{base_url}}"],
          "path": ["employees"],
          "query": [{ "key": "department", "value": "IT" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function() { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Stats",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/employees/stats/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function() { pm.response.to.have.status(200); });",
              "pm.test('Has stats', function() { pm.expect(pm.response.json()).to.have.property('total_employees'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Departments",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/employees/departments/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function() { pm.response.to.have.status(200); });",
              "pm.test('Has departments', function() { pm.expect(pm.response.json()).to.include('IT'); });"
            ]
          }
        }
      ]
    }
  ]
}
